rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Deny all access by default.
    match /{document=**} {
      allow read, write: if false;
    }

    // Sessions: only the backend service account can read/write.
    // Client-side Firestore access is not used — all access goes through
    // the backend, which authenticates via its GCP service account.
    // These rules exist as defence-in-depth to prevent direct Firestore
    // access if credentials were leaked.
    match /sessions/{sessionId} {
      // Allow authenticated service account access only.
      allow read, write: if request.auth != null
                         && request.auth.token.email_verified == true;

      // Preferences sub-collection
      match /preferences/{prefKey} {
        allow read, write: if request.auth != null
                           && request.auth.token.email_verified == true;
      }

      // Events sub-collection
      match /events/{eventId} {
        allow read, write: if request.auth != null
                           && request.auth.token.email_verified == true;
      }
    }
  }
}
