rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Deny all access by default.
    match /{document=**} {
      allow read, write: if false;
    }

    // All access goes through the backend (server SDK bypasses these rules).
    // These rules exist as defence-in-depth to block direct client access.

    match /users/{userId} {
      allow read, write: if false;
    }

    match /sessions/{sessionId} {
      allow read, write: if false;

      match /preferences/{prefKey} {
        allow read, write: if false;
      }

      match /events/{eventId} {
        allow read, write: if false;
      }
    }
  }
}
