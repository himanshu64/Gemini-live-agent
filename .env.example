# Google Cloud
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GCS_BUCKET=your-project-id-sightline-frames

# Auth – backend and frontend tokens MUST match
API_TOKEN=change-me-to-a-secure-random-string
NEXT_PUBLIC_API_TOKEN=change-me-to-a-secure-random-string

# Frontend
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# CORS (set to frontend URL in production)
FRONTEND_ORIGIN=http://localhost:3000

# WebSocket limits (optional, defaults shown)
# WS_MAX_MESSAGE_BYTES=1048576
# WS_RATE_LIMIT_PER_SEC=30
